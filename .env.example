# Copie este arquivo para ".env" e ajuste os valores conforme o seu ambiente.
# O docker-compose.yml lê estas variáveis automaticamente.

# Chave usada para assinar e validar os tokens JWT (só o auth-service usa;
# o gateway pergunta a ele se o token é válido). Troque este valor em produção.
SECRET_KEY=chave-padrao-apenas-para-desenvolvimento-trocar-em-producao

# URL do cotacao-service (usada pelo roteiro-service na Saga).
# Dentro do Docker Compose o host é o nome do serviço; fora dele, use localhost.
COTACAO_SERVICE_URL=http://cotacao-service:8003

# Ativa o log de todo SQL executado (útil para depuração, ruidoso em uso normal).
SQL_ECHO=false
